# VINOTERRA — пример файла окружения.
# Скопируйте в `.env` (в корне проекта) и подставьте свои значения. `.env` в git не коммитится.

# Ключ OpenAI — обязателен для режимов hybrid/vector (эмбеддинги базы и запроса) и сборки индекса.
# Режим bm25 работает офлайн без ключа.
OPENAI_API_KEY=sk-...

# Токен Telegram-бота от @BotFather — нужен только для запуска бота.
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Необязательно: фоллбэк-генерация через OpenAI-совместимый API (DeepSeek via vedai.by).
# Включается автоматически, если задан FALLBACK_API_KEY. Используется при недоступности OpenAI.
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://vedai.by/api/v1
# FALLBACK_CHAT_MODEL=deepseek-v3.1

# Необязательно: кастомный endpoint OpenAI-совместимого API (прокси и т.п.).
# OPENAI_BASE_URL=
